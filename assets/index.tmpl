<!DOCTYPE html>
<html lang="fa" dir="rtl" data-theme="rose-pine">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ .Title }}</title>
<link rel="stylesheet" href="style.css">
<script>window.ROSEVIEW = {{ .Data }};</script>
</head>
<body>
  <div class="container">
    <header class="topbar">
      {{ if .Title }}<h1>{{ .Title }}</h1>{{ end }}
      <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch theme"></button>
    </header>

    <section id="metadata" class="metadata" aria-label="Metadata">
      {{ range .Metadata }}
      <span class="chip"><span class="chip-key">{{ .Header }}</span><span class="chip-val">{{ .Value }}</span></span>
      {{ end }}
    </section>

    <div class="toolbar">
      <div class="search-wrap">
        <svg class="search-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="7" cy="7" r="5"></circle><line x1="11" y1="11" x2="14.5" y2="14.5"></line></svg>
        <input id="search" class="search" type="search" placeholder="جستجو در دروس..." autocomplete="off" autofocus>
      </div>
      <span id="count" class="count" aria-live="polite"></span>
    </div>

    <div class="table-wrap">
      <table>
        <thead id="table-head"></thead>
        <tbody id="table-body"></tbody>
      </table>
    </div>
  </div>
  <footer class="footer">No roses were harmed in the making of this project</footer>
  <script src="fuse.min.js"></script>
  <script src="app.js"></script>
</body>
</html>