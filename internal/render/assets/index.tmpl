<!DOCTYPE html>
<html lang="fa" dir="rtl" data-theme="rose-pine">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Roseview</title>
<link rel="icon" type="image/svg+xml" href="rose.svg">
<link rel="stylesheet" href="style.css">
<script>window.ROSEVIEW = {{ .Data }};</script>
</head>
<body>
  <svg aria-hidden="true" style="display:none">
    <symbol id="icon-rose" viewBox="0 0 24 24" fill="none" stroke="#eb6f92" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 10h-1a4 4 0 1 1 4-4v.534"/><path d="M17 6h1a4 4 0 0 1 1.42 7.74l-2.29.87a6 6 0 0 1-5.339-10.68l2.069-1.31"/><path d="M4.5 17c2.8-.5 4.4 0 5.5.8s1.8 2.2 2.3 3.7c-2 .4-3.5.4-4.8-.3-1.2-.6-2.3-1.9-3-4.2"/><path d="M9.77 12C4 15 2 22 2 22"/><circle cx="17" cy="8" r="2"/></symbol>
    <symbol id="icon-search" viewBox="0 0 24 24" fill="none" stroke="#6e6a86" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21 21-4.34-4.34"/><circle cx="11" cy="11" r="8"/></symbol>
    <symbol id="icon-sort-asc" viewBox="0 0 24 24" fill="none" stroke="#9ccfd8" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></symbol>
    <symbol id="icon-sort-desc" viewBox="0 0 24 24" fill="none" stroke="#9ccfd8" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></symbol>
    <symbol id="icon-minus" viewBox="0 0 24 24" fill="none" stroke="#e0def4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/></symbol>
    <symbol id="icon-github" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></symbol>
  </svg>
  <div class="container">
    <header class="topbar">
      <div class="branding" dir="ltr">
        <svg class="brand-rose" width="40" height="40" viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-rose"></use></svg>
        <div class="brand-text">
          <div class="brand-title">Roseview</div>
          <div class="brand-subtitle">A course list shouldn't come with thorns</div>
        </div>
      </div>
      {{ if .Title }}<h1>{{ .Title }}</h1>{{ end }}
      <a class="github-btn" href="https://github.com/TheRogueNico/roseview" target="_blank" rel="noopener" aria-label="Roseview on GitHub">
        <svg class="github-icon" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-github"></use></svg>
      </a>
    </header>

    <section id="metadata" class="metadata" aria-label="Metadata">
      {{ range .Metadata }}
      <span class="chip"><span class="chip-key">{{ .Header }}</span><span class="chip-val">{{ .Value }}</span></span>
      {{ end }}
    </section>

    <div class="toolbar">
      <div class="search-wrap">
        <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-search"></use></svg>
        <input id="search" class="search" type="search" placeholder="جستجو در دروس..." autocomplete="off" autofocus>
      </div>
      <span id="count" class="count" aria-live="polite"></span>
    </div>

    <div class="table-wrap">
      <table>
        <thead id="table-head"></thead>
        <tbody id="table-body"></tbody>
      </table>
    </div>
  </div>
  <footer class="footer">No roses were harmed in the making of this project</footer>
  <script src="fuse.min.js"></script>
  <script src="app.js"></script>
</body>
</html>